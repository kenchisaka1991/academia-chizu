!tests/rules/package.json
!tests/rules/package-lock.json
!functions/
!functions/**
!CLAUDE.md
!audio/
!audio/**
!scripts/
scripts/*
!scripts/gen_audio_manifest.js
!docs/
docs/*
!docs/grabacion_lista.md
node_modules/
